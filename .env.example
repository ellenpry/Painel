# Copie para .env (o .env não vai para o git).

# Primeiro administrador — usado só quando o banco ainda não tem nenhum usuário.
# Com ADMIN_SENHA: a conta é criada direto. Sem ADMIN_SENHA: o log do container mostra um link de convite.
ADMIN_EMAIL=admin@painel.local
ADMIN_NOME=Administrador
ADMIN_SENHA=

# Senha do PostgreSQL (troque em qualquer ambiente que não seja só o seu computador).
POSTGRES_PASSWORD=painel

# Endereço público usado nos links dos e-mails. Vazio = usa o endereço pelo qual a página foi aberta.
APP_URL=http://localhost:3000

# E-mail. Em desenvolvimento o Mailpit (http://localhost:8025) captura tudo.
# Em produção, aponte para um SMTP real (ex.: o do Google Workspace da empresa).
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_REMETENTE=Libera <nao-responda@painel.local>

# Em produção com HTTPS: true
COOKIE_SECURE=false
